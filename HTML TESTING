/* ---------- Snake ---------- */
function snakeGame(parent) {
  const N = 16, S = 20;
  const canvas = h('canvas', { width: N * S, height: N * S, role: 'img', 'aria-label': 'Snake game board' });
  const scoreEl = h('span');
  const bestEl = h('span');
  parent.append(h('div', { class: 'snake' },
    h('div', { class: 'hud' }, scoreEl, bestEl),
    canvas,
    h('p', { class: 'hint' }, 'Arrow keys, WASD or swipe to move. Space pauses.')));
  const ctx = canvas.getContext('2d');
  let best = Number(store.get('quantum_snake_best', 0)) || 0;
  let snake, dir, queue, food, score, timer = null, state = 'ready', message = '';

  function reset() {
    snake = [{ x: 8, y: 8 }, { x: 7, y: 8 }, { x: 6, y: 8 }];
    dir = { x: 1, y: 0 };
    queue = [];
    score = 0;
    state = 'ready';
    message = 'Press an arrow key to start';
    placeFood();
    hud();
    draw();
  }
  function placeFood() {
    const free = [];
    for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) if (!snake.some((p) => p.x === x && p.y === y)) free.push({ x, y });
    food = free.length ? free[Math.floor(Math.random() * free.length)] : null;
  }
  function hud() { scoreEl.textContent = 'Score ' + score; bestEl.textContent = 'Best ' + best; }
  function end(text) {
    state = 'over';
    message = text + ` Score ${score}. Press an arrow key to play again.`;
    if (score > best) { best = score; store.set('quantum_snake_best', best); }
    hud();
    draw();
    if (!reduced()) canvas.animate([{ transform: 'none' }, { transform: 'translateX(-7px)' }, { transform: 'translateX(6px)' }, { transform: 'translateX(-3px)' }, { transform: 'none' }], { duration: 280 });
  }
  function schedule() {
    clearTimeout(timer);
    if (state === 'run') timer = setTimeout(step, Math.max(55, 125 - score * 3));
  }
  function step() {
    if (queue.length) dir = queue.shift();
    const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };
    const eating = !!food && head.x === food.x && head.y === food.y;
    const body = eating ? snake : snake.slice(0, -1);
    if (head.x < 0 || head.y < 0 || head.x >= N || head.y >= N || body.some((p) => p.x === head.x && p.y === head.y)) { end('Game over.'); return; }
    snake.unshift(head);
    if (eating) {
      score++;
      placeFood();
      hud();
      if (!reduced()) scoreEl.animate([{ transform: 'scale(1.35)' }, { transform: 'none' }], { duration: 180, easing: 'ease-out' });
      if (!food) { end('You filled the board.'); return; }
    } else snake.pop();
    draw();
    schedule();
  }
  function turn(d) {
    if (state === 'over') reset();
    const last = queue.length ? queue[queue.length - 1] : dir;
    if (d.x === -last.x && d.y === -last.y) return;
    if (!(d.x === last.x && d.y === last.y) && queue.length < 2) queue.push(d);
    if (state !== 'run') { state = 'run'; schedule(); draw(); }
  }
  function pause() { if (state === 'run') { state = 'pause'; message = 'Paused'; clearTimeout(timer); draw(); } }
  function togglePause() {
    if (state === 'run') pause();
    else if (state === 'over') reset();
    else { state = 'run'; schedule(); draw(); }
  }

  function draw() {
    const bg = cssVar('--paper'), alt = cssVar('--chrome'), ink = cssVar('--ink'), acc = cssVar('--accent'), bad = cssVar('--bad');
    for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
      ctx.fillStyle = (x + y) % 2 ? alt : bg;
      ctx.fillRect(x * S, y * S, S, S);
    }
    snake.forEach((p, i) => {
      ctx.fillStyle = i === 0 ? acc : ink;
      ctx.fillRect(p.x * S + 1, p.y * S + 1, S - 2, S - 2);
    });
    if (food) {
      ctx.fillStyle = bad;
      ctx.beginPath();
      ctx.arc(food.x * S + S / 2, food.y * S + S / 2, S / 2 - 3, 0, Math.PI * 2);
      ctx.fill();
    }
    if (state !== 'run') {
      ctx.globalAlpha = .85;
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, N * S, N * S);
      ctx.globalAlpha = 1;
      ctx.fillStyle = ink;
      ctx.textAlign = 'center';
      ctx.font = "700 16px 'Atkinson Hyperlegible', system-ui, sans-serif";
      const words = message.split(' ');
      const lines = [];
      let line = '';
      words.forEach((w) => {
        if (ctx.measureText((line + ' ' + w).trim()).width > N * S - 40) { lines.push(line); line = w; }
        else line = (line + ' ' + w).trim();
      });
      lines.push(line);
      lines.forEach((l, i) => ctx.fillText(l, N * S / 2, N * S / 2 + (i - (lines.length - 1) / 2) * 22));
    }
  }

  const KEYS = { ArrowUp: [0, -1], ArrowDown: [0, 1], ArrowLeft: [-1, 0], ArrowRight: [1, 0], w: [0, -1], s: [0, 1], a: [-1, 0], d: [1, 0] };
  function onKey(e) {
    if (focusedKey !== 'games' || e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.target.closest && e.target.closest('input, textarea')) return;
    const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    if (KEYS[k]) { turn({ x: KEYS[k][0], y: KEYS[k][1] }); e.preventDefault(); }
    else if (k === ' ') { togglePause(); e.preventDefault(); }
  }
  document.addEventListener('keydown', onKey);

  let sx = 0, sy = 0;
  canvas.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; });
  canvas.addEventListener('pointerup', (e) => {
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (Math.max(Math.abs(dx), Math.abs(dy)) < 24) { if (state !== 'run') togglePause(); return; }
    if (Math.abs(dx) > Math.abs(dy)) turn({ x: Math.sign(dx), y: 0 });
    else turn({ x: 0, y: Math.sign(dy) });
  });

  reset();
  return {
    blur: pause,
    destroy() { clearTimeout(timer); state = 'dead'; document.removeEventListener('keydown', onKey); }
  };
}

/* ---------- Tic-tac-toe ---------- */
function tttGame(parent) {
  const LINES = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
  let board, turn, over, winLine, winner, mode = 'friend', timer = null, shown = Array(9).fill('');
  const status = h('p', { class: 'ttt-status', 'aria-live': 'polite' });
  const cells = Array.from({ length: 9 }, (_, i) => h('button', { class: 'cell', type: 'button', onclick: () => play(i) }));
  const modes = seg([['friend', 'Two players'], ['cpu', 'Play the computer']], () => mode, (m) => { mode = m; modes.refresh(); newGame(); }, 'Opponent');
  parent.append(h('div', { class: 'ttt-wrap' },
    status,
    h('div', { class: 'ttt' }, cells),
    h('div', { class: 'ttt-controls' }, modes.el, h('button', { class: 'btn', type: 'button', onclick: () => newGame() }, 'New game'))));

  const result = (b) => {
    for (const l of LINES) if (b[l[0]] && b[l[0]] === b[l[1]] && b[l[0]] === b[l[2]]) return { p: b[l[0]], line: l };
    return null;
  };
  function render() {
    const before = shown;
    shown = board.slice();
    cells.forEach((c, i) => {
      c.textContent = board[i];
      if (board[i] && !before[i] && !reduced()) c.animate([{ transform: 'scale(.4)', opacity: 0 }, { transform: 'scale(1)', opacity: 1 }], { duration: 190, easing: 'cubic-bezier(.2,.9,.3,1.4)' });
      c.classList.toggle('o', board[i] === 'O');
      c.classList.toggle('win', over && winLine.includes(i));
      c.disabled = over || !!board[i] || (mode === 'cpu' && turn === 'O');
      c.setAttribute('aria-label', `Square ${i + 1}, ${board[i] || 'empty'}`);
    });
    if (winner) status.textContent = mode === 'cpu' ? (winner === 'X' ? 'You win.' : 'The computer wins.') : `${winner} wins.`;
    else if (over) status.textContent = 'It’s a draw.';
    else status.textContent = mode === 'cpu' ? (turn === 'X' ? 'Your move (X).' : 'Computer is thinking…') : `${turn}’s turn.`;
  }
  function place(i) {
    board[i] = turn;
    const r = result(board);
    if (r) { over = true; winLine = r.line; winner = r.p; }
    else if (board.every(Boolean)) over = true;
    else turn = turn === 'X' ? 'O' : 'X';
    render();
  }
  function play(i) {
    if (over || board[i] || (mode === 'cpu' && turn !== 'X')) return;
    place(i);
    if (!over && mode === 'cpu') timer = setTimeout(() => place(cpuMove()), 350);
  }
  function score(b, t, d) {
    const r = result(b);
    if (r) return r.p === 'O' ? 10 - d : d - 10;
    if (b.every(Boolean)) return 0;
    let best = t === 'O' ? -Infinity : Infinity;
    for (let i = 0; i < 9; i++) {
      if (b[i]) continue;
      b[i] = t;
      const s = score(b, t === 'O' ? 'X' : 'O', d + 1);
      b[i] = '';
      best = t === 'O' ? Math.max(best, s) : Math.min(best, s);
    }
    return best;
  }
  function cpuMove() {
    let bestScore = -Infinity, moves = [];
    for (let i = 0; i < 9; i++) {
      if (board[i]) continue;
      board[i] = 'O';
      const s = score(board, 'X', 1);
      board[i] = '';
      if (s > bestScore) { bestScore = s; moves = [i]; } else if (s === bestScore) moves.push(i);
    }
    return moves[Math.floor(Math.random() * moves.length)];
  }
  function newGame() {
    clearTimeout(timer);
    board = Array(9).fill('');
    turn = 'X'; over = false; winLine = []; winner = null;
    render();
  }
  newGame();
  return { destroy: () => clearTimeout(timer) };
}

/* ================= Go ================= */
applyTheme();
applyWall();
applyBrightness();
updateNet();
tickClock();
setInterval(tickClock, 1000);
boot();
})();
