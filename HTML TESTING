function showLock() {
  $('#os').inert = true;
  $('#lock').inert = false;
  $('#lock-pw').value = '';
  $('#lock-err').textContent = '';
  $('#lock').hidden = false;
  setTimeout(() => $('#lock-pw').focus(), 50);
}
function lockSystem() {
  closePopovers();
  showLock();
}
let welcomed = false;
function showWelcome() {
  const w = $('#welcome');
  $('#welcome-avatar').textContent = $('#menu-avatar').textContent;
  $('#welcome-name').textContent = user.username;
  $('#lock').inert = true;
  $('#setup').inert = true;
  w.hidden = false;
  const quick = reduced();
  // Hide the sign-in screen once the welcome screen has faded in over it.
  setTimeout(() => { $('#lock').hidden = true; $('#setup').hidden = true; }, quick ? 0 : 280);
  setTimeout(() => {
    $('#os').inert = false;
    if (quick) { w.hidden = true; return; }
    w.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 550, easing: 'ease-in', fill: 'forwards' })
      .onfinish = () => { w.hidden = true; w.getAnimations().forEach((x) => x.cancel()); };
  }, quick ? 500 : 2200);
}
function unlock() {
  if (!welcomed) { welcomed = true; showWelcome(); return; }
  $('#os').inert = false;
  const leaving = [$('#lock'), $('#setup')].filter((el) => !el.hidden);
  if (reduced()) { leaving.forEach((el) => { el.hidden = true; }); return; }
  leaving.forEach((el) => {
    el.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(-16px)' }], { duration: 260, easing: 'ease-in', fill: 'forwards' })
      .onfinish = () => { el.hidden = true; el.getAnimations().forEach((x) => x.cancel()); };
  });
}

$('#lock-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  if (await verifyPw($('#lock-pw').value)) unlock();
  else {
    $('#lock-err').textContent = 'Wrong password. Try again.';
    $('#lock-pw').select();
    if (!reduced()) $('#lock-form').animate([{ transform: 'none' }, { transform: 'translateX(-8px)' }, { transform: 'translateX(7px)' }, { transform: 'translateX(-5px)' }, { transform: 'translateX(3px)' }, { transform: 'none' }], { duration: 320 });
