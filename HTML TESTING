function boot() {
  const fill = $('#boot-fill');
  let pct = 0, timer = null, done = false;
  const finish = () => {
    if (done) return;
    done = true;
    clearTimeout(timer);
    fill.style.width = '100%';
    setTimeout(() => {
      $('#boot').classList.add('out');
      setTimeout(() => { $('#boot').remove(); start(); }, 450);
    }, 350);
  };
  // Like a real startup bar: uneven jumps, not a steady crawl.
  const step = () => {
    pct = Math.min(100, pct + Math.random() * 18 + 6);
    fill.style.width = pct + '%';
    if (pct >= 100) finish(); else timer = setTimeout(step, 140 + Math.random() * 330);
  };
  timer = setTimeout(step, 900);
  window.addEventListener('keydown', finish, { once: true });
  $('#boot').addEventListener('pointerdown', finish, { once: true });
}

