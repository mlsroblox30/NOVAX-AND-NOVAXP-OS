<script>
(() => {
'use strict';

/* ================= Helpers ================= */
const OS_NAME = 'QuantumOS';
const NS = 'http://www.w3.org/2000/svg';
const root = document.documentElement;
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const clamp = (n, lo, hi) => Math.min(Math.max(n, lo), hi);
const startedAt = Date.now();

function h(tag, props, ...kids) {
  const el = document.createElement(tag);
  for (const [k, v] of Object.entries(props || {})) {
    if (v == null || v === false) continue;
    if (k === 'class') el.className = v;
    else if (k.startsWith('on') && typeof v === 'function') el.addEventListener(k.slice(2), v);
    else el.setAttribute(k, v === true ? '' : v);
  }
  for (const kid of kids.flat(Infinity)) {
    if (kid == null || kid === false) continue;
    el.append(kid instanceof Node ? kid : document.createTextNode(String(kid)));
  }
  return el;
}

function icon(name) {
  const svg = document.createElementNS(NS, 'svg');
  svg.setAttribute('class', 'ic');
  svg.setAttribute('aria-hidden', 'true');
  const use = document.createElementNS(NS, 'use');
  use.setAttribute('href', '#i-' + name);
  svg.append(use);
  return svg;
}

const store = {
  get(k, d) { try { const v = localStorage.getItem(k); return v == null ? d : JSON.parse(v); } catch { return d; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch { /* storage unavailable */ } },
  del(k) { try { localStorage.removeItem(k); } catch { /* storage unavailable */ } }
};

const cssVar = (n) => getComputedStyle(root).getPropertyValue(n).trim();

function seg(options, get, set, label) {
  const el = h('div', { class: 'seg', role: 'group', 'aria-label': label || null });
  const btns = options.map(([v, text]) => h('button', { type: 'button', 'aria-pressed': 'false', onclick: () => set(v) }, text));
  el.append(...btns);
  const refresh = () => btns.forEach((b, i) => b.setAttribute('aria-pressed', String(options[i][0] === get())));
  refresh();
  return { el, refresh };
}

/* ================= Preferences ================= */
const WALLS = [
  { id: 'teal', name: 'Teal' },
  { id: 'graph', name: 'Graph' },
  { id: 'olive', name: 'Olive' },
  { id: 'paper', name: 'Paper' }
];
const OPTIONAL = ['games', 'notepad', 'calculator', 'terminal'];

const THEMES = {
  classic: { name: 'Classic',
    light: { '--desk': '#4d7c7a', '--chrome': '#d9dcd6', '--chrome-d': '#c3c7bf', '--paper': '#fbfbf8', '--rule': '#b4b8b0', '--accent': '#2f54d6' },
    dark:  { '--desk': '#1d3231', '--chrome': '#2a2e2c', '--chrome-d': '#353a37', '--paper': '#191b1a', '--rule': '#454a46', '--accent': '#8aa4ff' } },
  graphite: { name: 'Graphite',
    light: { '--desk': '#5a5f66', '--chrome': '#dcdcdc', '--chrome-d': '#c6c6c6', '--paper': '#fafafa', '--rule': '#bdbdbd', '--accent': '#3b4252' },
    dark:  { '--desk': '#262a30', '--chrome': '#2d2d2d', '--chrome-d': '#3a3a3a', '--paper': '#1c1c1c', '--rule': '#4a4a4a', '--accent': '#9db4d6' } },
  sage: { name: 'Sage',
    light: { '--desk': '#6f8560', '--chrome': '#d6dccd', '--chrome-d': '#c1c9b7', '--paper': '#fafbf6', '--rule': '#b8c0ac', '--accent': '#3f6b35' },
    dark:  { '--desk': '#27341f', '--chrome': '#2b3027', '--chrome-d': '#363d31', '--paper': '#191c17', '--rule': '#454d3f', '--accent': '#98c98a' } },
  ocean: { name: 'Ocean',
    light: { '--desk': '#2e5379', '--chrome': '#d3dde8', '--chrome-d': '#bcc9d8', '--paper': '#fafcfe', '--rule': '#aebccd', '--accent': '#1f5fbf' },
    dark:  { '--desk': '#14283d', '--chrome': '#262d35', '--chrome-d': '#313a44', '--paper': '#171b20', '--rule': '#414b57', '--accent': '#8bb4f5' } },
  plum: { name: 'Plum',
    light: { '--desk': '#684a74', '--chrome': '#ddd5df', '--chrome-d': '#cbc0ce', '--paper': '#fcfafc', '--rule': '#bfb2c3', '--accent': '#8a3fa5' },
    dark:  { '--desk': '#2e1f36', '--chrome': '#2e2a31', '--chrome-d': '#39343d', '--paper': '#1b181d', '--rule': '#4a4350', '--accent': '#c99be0' } }
};
const ACCENTS = {
  blue:   { name: 'Blue',   c: ['#2f54d6', '#8aa4ff'] },
  teal:   { name: 'Teal',   c: ['#0e7c86', '#6fd0d8'] },
  green:  { name: 'Green',  c: ['#2f7d4f', '#7fd09a'] },
  orange: { name: 'Orange', c: ['#b45309', '#f0a35e'] },
  red:    { name: 'Red',    c: ['#c2412d', '#f08a78'] },
  purple: { name: 'Purple', c: ['#7a3fc4', '#c4a1f2'] }
};
const THEME_VARS = ['--desk', '--chrome', '--chrome-d', '--paper', '--rule', '--accent', '--on-accent'];

// Images you add are shrunk and kept in this browser (localStorage).
let customWalls = store.get('quantum_walls', []);
customWalls = (Array.isArray(customWalls) ? customWalls : []).filter((w) => w && w.id && typeof w.src === 'string');
function saveWalls() {
  try { localStorage.setItem('quantum_walls', JSON.stringify(customWalls)); return true; } catch { return false; }
}
const wallSrc = (id) => {
  if (typeof id !== 'string' || !id.startsWith('custom:')) return null;
  const w = customWalls.find((x) => 'custom:' + x.id === id);
  return w ? w.src : null;
};
const cssUrl = (src) => `url("${src.replace(/"/g, '%22')}")`;

const prefs = Object.assign(
  { theme: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light', look: 'classic', accent: 'auto',
    wall: 'teal', wallFit: 'fill', brightness: 100, installed: [...OPTIONAL] },
  store.get('quantum_prefs', {})
);
prefs.installed = (Array.isArray(prefs.installed) ? prefs.installed : OPTIONAL).filter((k) => OPTIONAL.includes(k));
if (!THEMES[prefs.look]) prefs.look = 'classic';
if (prefs.accent !== 'auto' && !ACCENTS[prefs.accent]) prefs.accent = 'auto';
if (!['fill', 'fit', 'tile'].includes(prefs.wallFit)) prefs.wallFit = 'fill';
if (!WALLS.some((w) => w.id === prefs.wall) && !wallSrc(prefs.wall)) prefs.wall = 'teal';
const savePrefs = () => store.set('quantum_prefs', prefs);

const bus = new EventTarget();
const onPrefs = (fn) => { bus.addEventListener('prefs', fn); return () => bus.removeEventListener('prefs', fn); };
const emitPrefs = () => bus.dispatchEvent(new Event('prefs'));

function reduced() { return matchMedia('(prefers-reduced-motion: reduce)').matches; }

function applyTheme() {
  root.dataset.theme = prefs.theme;
  THEME_VARS.forEach((k) => root.style.removeProperty(k));
  Object.entries(THEMES[prefs.look][prefs.theme]).forEach(([k, v]) => root.style.setProperty(k, v));
  const ac = ACCENTS[prefs.accent];
  if (ac) root.style.setProperty('--accent', prefs.theme === 'dark' ? ac.c[1] : ac.c[0]);
  root.style.setProperty('--on-accent', prefs.theme === 'dark' ? '#101318' : '#ffffff');
}
function applyWall() {
  const src = wallSrc(prefs.wall);
  $$('.wall').forEach((el) => {
    WALLS.forEach((w) => el.classList.remove('w-' + w.id));
    el.classList.remove('w-custom', 'fit-fill', 'fit-fit', 'fit-tile');
    if (src) { el.classList.add('w-custom', 'fit-' + prefs.wallFit); el.style.backgroundImage = cssUrl(src); }
    else { el.style.backgroundImage = ''; el.classList.add('w-' + prefs.wall); }
  });
}
function applyBrightness() { $('#dim').style.opacity = String((100 - prefs.brightness) / 100); }

function restyle() {
  root.classList.add('theming');
  clearTimeout(restyle.timer);
  restyle.timer = setTimeout(() => root.classList.remove('theming'), 350);
  savePrefs(); applyTheme(); emitPrefs();
}
function setTheme(t) { if (t !== prefs.theme) { prefs.theme = t; restyle(); } }
function setLook(id) { if (THEMES[id] && id !== prefs.look) { prefs.look = id; restyle(); } }
function setAccent(id) { if ((id === 'auto' || ACCENTS[id]) && id !== prefs.accent) { prefs.accent = id; restyle(); } }

function setWall(w) {
  if (w === prefs.wall) return;
  if (!WALLS.some((x) => x.id === w) && !wallSrc(w)) return;
  if (!reduced()) {
    // Cross-fade from a copy of the old wallpaper.
    const bg = getComputedStyle($('#wall'));
    const ghost = h('div', { class: 'ghost' });
    Object.assign(ghost.style, { backgroundColor: bg.backgroundColor, backgroundImage: bg.backgroundImage, backgroundSize: bg.backgroundSize, backgroundRepeat: bg.backgroundRepeat, backgroundPosition: bg.backgroundPosition });
    $('#wall').after(ghost);
    ghost.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 450, easing: 'ease-out' }).onfinish = () => ghost.remove();
  }
  prefs.wall = w; savePrefs(); applyWall(); emitPrefs();
}
function setWallFit(f) { prefs.wallFit = f; savePrefs(); applyWall(); emitPrefs(); }

function readImage(file) {
  return new Promise((resolve, reject) => {
    if (!file || !file.type.startsWith('image/')) { reject(new Error('Choose an image file.')); return; }
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      const k = Math.min(1, 1920 / Math.max(img.naturalWidth, img.naturalHeight));
      const c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(img.naturalWidth * k));
      c.height = Math.max(1, Math.round(img.naturalHeight * k));
      const g = c.getContext('2d');
      g.fillStyle = '#fff';
      g.fillRect(0, 0, c.width, c.height);
      g.drawImage(img, 0, 0, c.width, c.height);
      URL.revokeObjectURL(url);
      try { resolve(c.toDataURL('image/jpeg', 0.82)); } catch { reject(new Error('Couldn’t read that image.')); }
    };
    img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('Couldn’t open that image.')); };
    img.src = url;
  });
}
// Returns an error message, or null when the image was added and applied.
function addCustom(src, name) {
  if (customWalls.length >= 6) return 'You can keep up to 6 images. Remove one first.';
  const w = { id: 'w' + Date.now().toString(36) + Math.floor(Math.random() * 1000), name: name || 'Image', src };
  customWalls.push(w);
  if (!saveWalls()) { customWalls.pop(); return 'Not enough browser storage for that image. Remove one, or pick a smaller image.'; }
  setWall('custom:' + w.id);
  return null;
}
function removeCustom(id) {
  customWalls = customWalls.filter((w) => w.id !== id);
  saveWalls();
  if (prefs.wall === 'custom:' + id) { prefs.wall = 'teal'; savePrefs(); applyWall(); }
  emitPrefs();
}

/* ================= Account ================= */
let user = null;

async function hashPw(pw, salt) {
  const data = new TextEncoder().encode(salt + ':' + pw);
  if (window.crypto && crypto.subtle) {
    const buf = await crypto.subtle.digest('SHA-256', data);
    return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
  }
  let x = 5381;
  for (const b of data) x = ((x << 5) + x + b) >>> 0;
  return 'weak-' + x.toString(16);
}
function makeSalt() {
  const a = new Uint8Array(8);
  if (window.crypto && crypto.getRandomValues) crypto.getRandomValues(a);
  else a.forEach((_, i) => { a[i] = Math.floor(Math.random() * 256); });
  return [...a].map((b) => b.toString(16).padStart(2, '0')).join('');
}
async function makeUser(username, pw) {
  const salt = makeSalt();
  return { username, salt, hash: await hashPw(pw, salt) };
}
async function verifyPw(pw) {
  if (!user) return false;
  if (user.hash) return (await hashPw(pw, user.salt)) === user.hash;
  // Accounts made by the old version stored the password as plain text. Check it once, then upgrade.
  if (user.password !== undefined && pw === user.password) {
    user = await makeUser(user.username, pw);
    store.set('quantum_user', user);
    return true;
  }
  return false;
}
function applyUser() {
  const letter = (user.username.trim().charAt(0) || 'Q').toUpperCase();
  $('#lock-avatar').textContent = letter;
  $('#menu-avatar').textContent = letter;
  $('#lock-name').textContent = user.username;
  $('#menu-name').textContent = user.username;
}
function eraseComputer() {
  if (!confirm('Erase this computer? This deletes your account, notes and settings from this browser.')) return;
  ['quantum_user', 'quantum_prefs', 'quantum_notes', 'quantum_snake_best', 'quantum_walls'].forEach((k) => store.del(k));
  location.reload();
}

/* ================= Window manager ================= */
const wins = new Map();
let zTop = 10;
let focusedKey = null;
const layer = $('#windows');

const installedKeys = () => Object.keys(APPS).filter((k) => APPS[k].core || prefs.installed.includes(k));

function appIcon(key, size) {
  const a = APPS[key];
  const el = h('span', { class: 'appicon c-' + a.color }, icon(a.icon));
  el.style.setProperty('--s', size + 'px');
  return el;
}

// Windows fly to and from their taskbar button.
function flyAnim(rec, opening) {
  if (reduced()) return null;
  const btn = $(`.task-btn[data-key="${rec.key}"]`);
  if (!btn) return null;
  const t = btn.getBoundingClientRect();
  const r = rec.el.getBoundingClientRect();
  if (!r.width || !r.height) return null;
  const dx = t.left + t.width / 2 - (r.left + r.width / 2);
  const dy = t.top + t.height / 2 - (r.top + r.height / 2);
  const small = `translate(${dx}px, ${dy}px) scale(${Math.max(.05, t.width / r.width)}, ${Math.max(.05, t.height / r.height)})`;
  const frames = [{ transform: small, opacity: 0 }, { transform: 'none', opacity: 1 }];
  if (!opening) frames.reverse();
  return rec.el.animate(frames, {
    duration: opening ? 280 : 200,
    easing: opening ? 'cubic-bezier(.2,.8,.2,1)' : 'cubic-bezier(.5,0,.8,.4)',
    fill: opening ? 'none' : 'forwards'
  });
}

function openApp(key) {
  const app = APPS[key];
  if (!app || !installedKeys().includes(key)) return;
  if (wins.has(key)) { focusWin(key); return; }

  const area = layer.getBoundingClientRect();
  const w = Math.min(app.w, area.width - 16);
  const hh = Math.min(app.h, area.height - 16);
  const n = wins.size % 6;
  const left = clamp(128 + n * 30, 0, Math.max(0, area.width - w));
  const top = clamp(24 + n * 30, 0, Math.max(0, area.height - hh));

  const rec = { key, max: false, min: false, prev: null, api: {} };
  const el = h('section', { class: 'win', role: 'dialog', 'aria-label': app.name });
  el.style.cssText = `left:${left}px;top:${top}px;width:${w}px;height:${hh}px`;
  rec.el = el;

  const btnMin = h('button', { class: 'wbtn', type: 'button', title: 'Minimize', 'aria-label': 'Minimize', onclick: () => minimizeWin(key) }, icon('min'));
  rec.maxBtn = app.fixed ? null : h('button', { class: 'wbtn', type: 'button', title: 'Maximize', 'aria-label': 'Maximize', onclick: () => toggleMax(key) }, icon('max'));
  const btnClose = h('button', { class: 'wbtn close', type: 'button', title: 'Close', 'aria-label': 'Close', onclick: () => closeWin(key) }, icon('x'));
  const tb = h('div', { class: 'titlebar' },
    h('span', { class: 'ttl' }, appIcon(key, 18), app.name),
    h('span', { class: 'ctrls' }, btnMin, rec.maxBtn, btnClose));
  tb.addEventListener('pointerdown', (e) => startDrag(e, rec));
  tb.addEventListener('dblclick', (e) => { if (!app.fixed && !e.target.closest('button')) toggleMax(key); });

  const body = h('div', { class: 'win-body' });
  el.append(tb, body);
  if (!app.fixed) {
    const grip = h('div', { class: 'grip', 'aria-hidden': 'true' });
    grip.addEventListener('pointerdown', (e) => startResize(e, rec, app));
    el.append(grip);
  }
  el.addEventListener('pointerdown', () => { if (focusedKey !== key || rec.min) focusWin(key); }, true);

  wins.set(key, rec);
  layer.append(el);
  rec.api = app.build(body, { close: () => closeWin(key) }) || {};
  if (area.width < 700 && !app.fixed) toggleMax(key, true);
  focusWin(key);
  rec.anim = flyAnim(rec, true);
}

function focusWin(key) {
  const rec = wins.get(key);
  if (!rec) return;
  if (focusedKey === key && !rec.min) return;
  const prev = wins.get(focusedKey);
  if (prev && prev !== rec) { prev.el.classList.remove('active'); prev.api.blur?.(); }
  const wasMin = rec.min;
  rec.anim?.cancel();
  rec.anim = null;
  rec.min = false;
  rec.el.classList.remove('is-min');
  if (wasMin) rec.anim = flyAnim(rec, true);
  zTop++;
  rec.el.style.zIndex = zTop;
  rec.el.classList.add('active');
  focusedKey = key;
  $('#active-title').textContent = APPS[key].name;
  if (!reduced()) $('#active-title').animate([{ opacity: 0 }, { opacity: 1 }], { duration: 160 });
  updateTaskbar();
  rec.api.focus?.();
}

function focusTopmost() {
  let top = null;
  for (const r of wins.values()) {
    if (!r.min && (!top || +r.el.style.zIndex > +top.el.style.zIndex)) top = r;
  }
  if (top) focusWin(top.key);
  else { focusedKey = null; $('#active-title').textContent = OS_NAME; updateTaskbar(); }
}

function minimizeWin(key) {
  const rec = wins.get(key);
  if (!rec) return;
  rec.min = true;
  rec.el.classList.remove('active');
  const a = flyAnim(rec, false);
  if (a) {
    rec.anim = a;
    a.onfinish = () => {
      if (rec.min && rec.anim === a) { rec.el.classList.add('is-min'); a.cancel(); rec.anim = null; }
    };
  } else rec.el.classList.add('is-min');
  rec.api.blur?.();
  if (focusedKey === key) { focusedKey = null; focusTopmost(); } else updateTaskbar();
}

function closeWin(key) {
  const rec = wins.get(key);
  if (!rec) return;
  rec.api.destroy?.();
  wins.delete(key);
  rec.el.style.pointerEvents = 'none';
  rec.el.classList.remove('active');
  rec.anim?.cancel();
  const gone = reduced() ? null : rec.el.animate([{ transform: 'none', opacity: 1 }, { transform: 'scale(.96)', opacity: 0 }], { duration: 130, easing: 'ease-in', fill: 'forwards' });
  if (gone) gone.onfinish = () => rec.el.remove(); else rec.el.remove();
  if (focusedKey === key) { focusedKey = null; focusTopmost(); } else updateTaskbar();
}

function toggleMax(key, instant) {
  const rec = wins.get(key);
  if (!rec || !rec.maxBtn) return;
  const el = rec.el;
  if (!instant && !reduced()) {
    el.classList.add('tween');
    clearTimeout(rec.tweenTimer);
    rec.tweenTimer = setTimeout(() => el.classList.remove('tween'), 280);
  }
  if (!rec.max) {
    rec.prev = { left: el.style.left, top: el.style.top, width: el.style.width, height: el.style.height };
    Object.assign(el.style, { left: '0px', top: '0px', width: '100%', height: '100%' });
    el.classList.add('max');
  } else {
    Object.assign(el.style, rec.prev);
    el.classList.remove('max');
  }
  rec.max = !rec.max;
  rec.maxBtn.replaceChildren(icon(rec.max ? 'restore' : 'max'));
  const label = rec.max ? 'Restore' : 'Maximize';
  rec.maxBtn.title = label;
  rec.maxBtn.setAttribute('aria-label', label);
}

function startDrag(e, rec) {
  if (e.button !== 0 || e.target.closest('button')) return;
  focusWin(rec.key);
  if (rec.max) return;
  const tb = e.currentTarget;
  const el = rec.el;
  const sx = e.clientX, sy = e.clientY, sl = el.offsetLeft, st = el.offsetTop;
  tb.setPointerCapture(e.pointerId);
  const move = (ev) => {
    const a = layer.getBoundingClientRect();
    el.style.left = clamp(sl + ev.clientX - sx, 90 - el.offsetWidth, a.width - 90) + 'px';
    el.style.top = clamp(st + ev.clientY - sy, 0, a.height - 30) + 'px';
  };
  const up = () => {
    tb.removeEventListener('pointermove', move);
    tb.removeEventListener('pointerup', up);
    tb.removeEventListener('pointercancel', up);
  };
  tb.addEventListener('pointermove', move);
  tb.addEventListener('pointerup', up);
  tb.addEventListener('pointercancel', up);
}

function startResize(e, rec, app) {
  if (e.button !== 0 || rec.max) return;
  e.preventDefault();
  const grip = e.currentTarget;
  const el = rec.el;
  const sx = e.clientX, sy = e.clientY, sw = el.offsetWidth, sh = el.offsetHeight;
  const [minW, minH] = app.min || [300, 200];
  grip.setPointerCapture(e.pointerId);
  const move = (ev) => {
    const a = layer.getBoundingClientRect();
    el.style.width = clamp(sw + ev.clientX - sx, minW, Math.max(minW, a.width - el.offsetLeft)) + 'px';
    el.style.height = clamp(sh + ev.clientY - sy, minH, Math.max(minH, a.height - el.offsetTop)) + 'px';
  };
  const up = () => {
    grip.removeEventListener('pointermove', move);
    grip.removeEventListener('pointerup', up);
    grip.removeEventListener('pointercancel', up);
  };
  grip.addEventListener('pointermove', move);
  grip.addEventListener('pointerup', up);
  grip.addEventListener('pointercancel', up);
}

window.addEventListener('resize', () => {
  const a = layer.getBoundingClientRect();
  for (const rec of wins.values()) {
    if (rec.max) continue;
    const el = rec.el;
    el.style.width = Math.min(el.offsetWidth, a.width) + 'px';
    el.style.height = Math.min(el.offsetHeight, a.height) + 'px';
    el.style.left = clamp(el.offsetLeft, 90 - el.offsetWidth, a.width - 90) + 'px';
    el.style.top = clamp(el.offsetTop, 0, Math.max(0, a.height - 30)) + 'px';
  }
});

