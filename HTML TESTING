  calculator: {
    name: 'Calculator', desc: 'Do the sums', icon: 'calc', color: 'green', w: 280, h: 410, fixed: true,
    build(body) {
      let acc = null, op = null, cur = '0', fresh = true, expr = '', failed = false;
      const OPS = { '+': '+', '-': '−', '*': '×', '/': '÷' };
      const ex = h('div', { class: 'calc-expr' });
      const res = h('div', { class: 'calc-res', 'aria-live': 'polite' });
      const render = () => {
        ex.textContent = expr;
        res.textContent = cur;
        res.style.fontSize = cur.length > 14 ? '18px' : cur.length > 10 ? '24px' : '32px';
      };
      const toStr = (n) => (Number.isFinite(n) ? String(Number(n.toPrecision(12))) : null);
      const apply = (a, o, b) => (o === '+' ? a + b : o === '-' ? a - b : o === '*' ? a * b : b === 0 ? NaN : a / b);
      const num = () => parseFloat(cur);

      function clearAll() { acc = null; op = null; cur = '0'; fresh = true; expr = ''; failed = false; render(); }
      function fail() { failed = true; cur = 'Can’t divide by zero'; expr = ''; acc = null; op = null; fresh = true; render(); }
      function digit(d) {
        if (failed) clearAll();
        if (fresh) { cur = d; fresh = false; }
        else if (cur.replace(/[-.]/g, '').length < 15) cur = cur === '0' ? d : cur + d;
        render();
      }
      function dot() {
        if (failed) clearAll();
        if (fresh) { cur = '0.'; fresh = false; }
        else if (!cur.includes('.')) cur += '.';
        render();
      }
      function operator(o) {
        if (failed) return;
        if (op && !fresh) {
          const r = toStr(apply(acc, op, num()));
          if (r === null) return fail();
          acc = parseFloat(r); cur = r;
        } else acc = num();
        op = o; fresh = true;
        expr = `${toStr(acc)} ${OPS[o]}`;
        render();
      }
      function equals() {
        if (failed || !op) return;
        const b = num();
        const r = toStr(apply(acc, op, b));
        if (r === null) return fail();
        expr = `${toStr(acc)} ${OPS[op]} ${toStr(b)} =`;
        cur = r; acc = null; op = null; fresh = true;
        render();
        if (!reduced()) res.animate([{ opacity: .25, transform: 'translateY(5px)' }, { opacity: 1, transform: 'none' }], { duration: 160, easing: 'ease-out' });
      }
      function back() {
        if (failed) return clearAll();
        if (fresh) return;
        cur = cur.length > 1 && !(cur.length === 2 && cur[0] === '-') ? cur.slice(0, -1) : '0';
        render();
      }
      function negate() {
        if (failed || cur === '0') return;
        cur = cur.startsWith('-') ? cur.slice(1) : '-' + cur;
        render();
      }

      const key = (label, cls, fn, aria) => h('button', { class: 'key ' + cls, type: 'button', 'aria-label': aria || null, onclick: fn }, label);
      const d = (n) => key(n, '', () => digit(n));
      body.append(h('div', { class: 'calc' },
        h('div', { class: 'calc-screen' }, ex, res),
        h('div', { class: 'keys' },
          key('C', 'clr', clearAll, 'Clear'), key('⌫', 'op', back, 'Backspace'), key('±', 'op', negate, 'Change sign'), key('÷', 'op', () => operator('/'), 'Divide'),
          d('7'), d('8'), d('9'), key('×', 'op', () => operator('*'), 'Multiply'),
          d('4'), d('5'), d('6'), key('−', 'op', () => operator('-'), 'Subtract'),
          d('1'), d('2'), d('3'), key('+', 'op', () => operator('+'), 'Add'),
          key('0', 'wide', () => digit('0')), key('.', '', dot, 'Decimal point'), key('=', 'eq', equals, 'Equals'))));
      render();

      const onKey = (e) => {
        if (focusedKey !== 'calculator' || e.ctrlKey || e.metaKey || e.altKey) return;
        const k = e.key;
        if (/^\d$/.test(k)) digit(k);
        else if (k === '.' || k === ',') dot();
        else if (k.length === 1 && '+-*/'.includes(k)) operator(k);
        else if (k === 'Enter' || k === '=') equals();
        else if (k === 'Backspace') back();
        else if (k === 'Escape') clearAll();
        else return;
        e.preventDefault();
      };
      document.addEventListener('keydown', onKey);
      return { destroy: () => document.removeEventListener('keydown', onKey) };
    }
  },

