        const line = input.value.trim();
        input.value = '';
        out.append(h('div', null, h('span', { class: 'prompt' }, promptText), line));
        if (line) {
          history.push(line);
          const [name, ...args] = line.split(/\s+/);
          const fn = Object.prototype.hasOwnProperty.call(commands, name) ? commands[name] : null;
          if (fn) fn(args); else print(`${name}: command not found. Type help to list commands.`, 'err');
        }
        hi = history.length;
        term.scrollTop = term.scrollHeight;
      });
      term.addEventListener('click', () => { if (!String(getSelection())) input.focus(); });
      print(`${OS_NAME} shell. Type help to list commands.`, 'dim');
      return { focus: () => input.focus() };
    }
  }
