<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>QuantumOS</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect x='3' y='3' width='8' height='8'/%3E%3Crect x='13' y='3' width='8' height='8'/%3E%3Crect x='3' y='13' width='8' height='8'/%3E%3Ccircle cx='17' cy='17' r='4'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=IBM+Plex+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  --font: 'Atkinson Hyperlegible', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --mono: 'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace;
  --bar-h: 28px;
  --task-h: 44px;

  --desk: #4d7c7a;
  --chrome: #d9dcd6;
  --chrome-d: #c3c7bf;
  --paper: #fbfbf8;
  --ink: #1e1f1e;
  --ink-2: #565b56;
  --line: #1e1f1e;
  --rule: #b4b8b0;
  --accent: #2f54d6;
  --on-accent: #ffffff;
  --hi: #f2c744;
  --bad: #b9382a;
  --good: #2f7d4f;
  --shadow: rgba(0, 0, 0, .35);
}
[data-theme="dark"] {
  --desk: #1d3231;
  --chrome: #2a2e2c;
  --chrome-d: #353a37;
  --paper: #191b1a;
  --ink: #e8eae5;
  --ink-2: #a2a8a1;
  --line: #6f7771;
  --rule: #454a46;
  --accent: #8aa4ff;
  --on-accent: #101318;
  --hi: #e8b94a;
  --bad: #ef8b7a;
  --good: #6cc48b;
  --shadow: rgba(0, 0, 0, .55);
}

* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body {
  font-family: var(--font);
  font-size: 14px;
  line-height: 1.4;
  color: var(--ink);
  background: #101312;
  overflow: hidden;
  user-select: none;
  -webkit-user-select: none;
  -webkit-tap-highlight-color: transparent;
}
input, textarea { user-select: text; -webkit-user-select: text; }
[hidden] { display: none !important; }
button { font: inherit; color: inherit; cursor: pointer; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
p { margin: 0; }
.sub { font-size: 12px; color: var(--ink-2); }

.ic { width: 1em; height: 1em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex: none; }

/* ---------- Wallpapers (flat colour and pattern, no photos) ---------- */
.wall { position: fixed; inset: 0; }
.w-teal  { background-color: var(--desk); background-image: radial-gradient(rgba(0,0,0,.16) 1px, transparent 1.3px); background-size: 5px 5px; }
.w-graph { background-color: #2e4259; background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px); background-size: 36px 36px; }
.w-olive { background-color: #66723f; background-image: repeating-linear-gradient(135deg, rgba(0,0,0,.1) 0 2px, transparent 2px 9px); }
.w-paper { background-color: #c8cac3; }

/* ---------- Shared controls ---------- */
.btn {
  height: 30px; padding: 0 12px;
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  border: 1.5px solid var(--line); border-radius: 4px;
  background: var(--chrome); color: var(--ink);
  font-size: 13px; font-weight: 700;
}
.btn:hover { background: var(--chrome-d); }
.btn:active { transform: translateY(1px); }
.btn.primary { background: var(--accent); color: var(--on-accent); }
.btn.primary:hover { filter: brightness(1.08); }
.btn.danger { color: var(--bad); }
.btn:disabled { opacity: .5; cursor: default; }
.link { background: none; border: 0; padding: 0; color: var(--accent); text-decoration: underline; font-size: 12px; text-align: left; }
.field {
  height: 32px; padding: 0 8px; width: 100%;
  border: 1.5px solid var(--line); border-radius: 4px;
  background: var(--paper); color: var(--ink); font: inherit;
}
.field.grow { flex: 1; min-width: 0; }
.err { color: var(--bad); font-size: 13px; min-height: 1.4em; }
.avatar {
  display: grid; place-items: center; flex: none;
  width: 32px; height: 32px;
  border: 1.5px solid var(--line); border-radius: 6px;
  background: var(--hi); color: #1e1f1e; font-weight: 700;
}
.avatar.big { width: 48px; height: 48px; font-size: 20px; }
.seg { display: inline-flex; border: 1.5px solid var(--line); border-radius: 5px; overflow: hidden; }
.seg button { height: 28px; padding: 0 12px; border: 0; background: var(--paper); font-size: 13px; }
.seg button + button { border-left: 1.5px solid var(--line); }
.seg button[aria-pressed="true"] { background: var(--ink); color: var(--paper); font-weight: 700; }

.appicon {
  --s: 28px;
  width: var(--s); height: var(--s);
  display: grid; place-items: center; flex: none;
  border: 1.5px solid #1e1f1e; border-radius: calc(var(--s) * .25);
  background: var(--c, #cfd1cb); color: #1e1f1e;
}
.appicon .ic { width: 58%; height: 58%; }
.c-blue { --c: #93b7e6; } .c-yellow { --c: #f2c744; } .c-green { --c: #a3d1a0; }
.c-red { --c: #eb9a8a; } .c-grey { --c: #cfd1cb; } .c-white { --c: #f4f4ef; }

/* ---------- Boot (black screen, logo, thin bar) ---------- */
#boot {
  position: fixed; inset: 0; z-index: 900;
  background: #000; color: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 64px;
  cursor: none;
}
#boot.out { opacity: 0; transition: opacity .45s ease-in; }
.boot-logo { width: 88px; height: 88px; fill: #fff; stroke: none; animation: bootLogo .9s ease-out both; }
#boot-bar { width: 168px; height: 5px; border-radius: 3px; background: #3a3a3a; overflow: hidden; animation: fadeIn .5s .5s ease-out both; }
#boot-fill { display: block; width: 0; height: 100%; border-radius: 3px; background: #fff; transition: width .35s ease-out; }

/* ---------- Welcome (after sign-in) ---------- */
#welcome { z-index: 870; }
#welcome::before { content: ""; position: absolute; inset: 0; background: rgba(0, 0, 0, .42); }
.welcome-card { position: relative; display: grid; justify-items: center; gap: 16px; color: #fff; text-shadow: 0 1px 0 rgba(0,0,0,.35); }
.welcome-card .avatar { width: 96px; height: 96px; font-size: 40px; border-radius: 20px; }
.welcome-card b { font-size: 24px; font-weight: 400; }
.welcome-card p { font-size: 16px; }
.spinner { position: relative; width: 44px; height: 44px; margin: 14px 0 6px; }
.spinner i { position: absolute; inset: 0; opacity: 0; animation: orbit 2.4s linear infinite; animation-delay: calc(var(--i) * .15s); }
.spinner i::after { content: ""; position: absolute; top: 0; left: 50%; width: 6px; height: 6px; margin-left: -3px; border-radius: 50%; background: #fff; }
@keyframes orbit {
  0% { transform: rotate(0deg); opacity: 0; }
  4% { opacity: 1; }
  35% { transform: rotate(230deg); }
  65% { transform: rotate(310deg); }
  95% { transform: rotate(720deg); opacity: 1; }
  100% { transform: rotate(720deg); opacity: 0; }
}
@keyframes bootLogo { from { opacity: 0; transform: scale(.92); } }

/* ---------- Setup and lock ---------- */
.screen { display: grid; place-items: center; padding: 16px; }
#setup { z-index: 790; }
#lock { z-index: 800; }
.dialog { width: min(380px, 100%); background: var(--paper); border: 1.5px solid var(--line); border-radius: 6px; box-shadow: 4px 4px 0 var(--shadow); overflow: hidden; position: relative; }
.dialog-title, .titlebar.static { height: 30px; display: flex; align-items: center; padding: 0 10px; background: repeating-linear-gradient(0deg, var(--chrome) 0 2px, var(--chrome-d) 2px 3px); border-bottom: 1.5px solid var(--line); }
.dialog-title span { background: var(--chrome); padding: 0 8px; font-weight: 700; font-size: 13px; }
.dialog-body { padding: 18px; display: grid; gap: 14px; }
.fieldrow { display: grid; gap: 4px; }
.fieldrow label { font-weight: 700; font-size: 13px; }
.who { display: flex; align-items: center; gap: 12px; min-width: 0; }
.actions { display: flex; gap: 8px; }
.lock-time { position: absolute; left: 5vw; bottom: 5vh; color: #fff; text-shadow: 0 2px 0 rgba(0,0,0,.35); }
.lock-time b { display: block; font-size: clamp(48px, 9vw, 96px); line-height: 1; font-weight: 700; }
.lock-time span { font-size: 18px; }

/* ---------- Menu bar ---------- */
#wall { z-index: 0; }
#menubar {
  position: fixed; top: 0; left: 0; right: 0; height: var(--bar-h); z-index: 60;
  display: flex; align-items: center; justify-content: space-between; padding: 0 4px;
  background: var(--chrome); border-bottom: 1.5px solid var(--line); font-size: 13px;
}
.mb-btn { display: flex; align-items: center; gap: 8px; height: 22px; padding: 0 8px; border: 0; border-radius: 4px; background: transparent; }
.mb-btn:hover, .mb-btn[aria-expanded="true"] { background: var(--ink); color: var(--paper); }
#sysmenu .ic { font-size: 16px; }
#active-title { font-weight: 700; }
.dot { width: 9px; height: 9px; border-radius: 50%; background: var(--good); border: 1.5px solid currentColor; }
.dot.off { background: var(--bad); }

/* ---------- Desktop ---------- */
#desktop { position: fixed; top: var(--bar-h); left: 0; right: 0; bottom: var(--task-h); overflow: hidden; z-index: 1; }
#icons { position: absolute; inset: 0; display: flex; flex-direction: column; flex-wrap: wrap; align-content: flex-start; gap: 6px; padding: 12px; }
.dicon { width: 92px; display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 6px 4px; border: 0; background: none; color: #fff; }
.dicon .label { font-size: 13px; line-height: 1.15; padding: 1px 5px; border-radius: 3px; text-shadow: 0 1px 0 rgba(0,0,0,.7), 0 0 4px rgba(0,0,0,.6); max-width: 100%; }
.dicon.sel .label { background: var(--accent); color: var(--on-accent); text-shadow: none; }
#windows { position: absolute; inset: 0; pointer-events: none; }

/* ---------- Taskbar ---------- */
#taskbar { position: fixed; left: 0; right: 0; bottom: 0; height: var(--task-h); z-index: 60; display: flex; align-items: center; gap: 4px; padding: 0 8px; background: var(--chrome); border-top: 1.5px solid var(--line); overflow-x: auto; }
.task-btn { position: relative; display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 12px 0 6px; border: 1.5px solid transparent; border-radius: 5px; background: transparent; font-size: 13px; white-space: nowrap; }
.task-btn:hover { background: var(--chrome-d); }
.task-btn.focused { background: var(--paper); border-color: var(--line); }
.task-btn.open::after { content: ""; position: absolute; left: 8px; right: 8px; bottom: 1px; height: 3px; border-radius: 2px; background: var(--ink); }
.task-btn.min::after { opacity: .35; }

/* ---------- Popovers ---------- */
.pop { position: fixed; z-index: 70; top: calc(var(--bar-h) + 4px); background: var(--paper); border: 1.5px solid var(--line); border-radius: 6px; box-shadow: 3px 3px 0 var(--shadow); animation: pop .12s ease-out; }
#startmenu { left: 6px; width: min(330px, calc(100vw - 12px)); }
#cc { right: 6px; width: min(290px, calc(100vw - 12px)); padding: 6px 0; }
.pop-search { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-bottom: 1.5px solid var(--line); }
.pop-search input { flex: 1; border: 0; background: transparent; color: var(--ink); font: inherit; outline: none; min-width: 0; }
.pop-search:focus-within { box-shadow: inset 0 -3px 0 var(--accent); }
.start-list { list-style: none; margin: 0; padding: 4px 0; max-height: min(50vh, 360px); overflow: auto; }
.start-list .empty { padding: 12px; color: var(--ink-2); }
.start-item { display: flex; align-items: center; gap: 12px; width: 100%; padding: 6px 10px; border: 0; background: none; text-align: left; }
.start-item .meta { display: grid; }
.start-item:hover, .start-item:focus-visible { background: var(--accent); color: var(--on-accent); outline: none; }
.start-item:hover .sub, .start-item:focus-visible .sub { color: inherit; opacity: .85; }
.pop-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 10px; border-top: 1.5px solid var(--line); }
.pop-foot .acts { display: flex; gap: 6px; }
.cc-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 12px; }
.cc-row.col { flex-direction: column; align-items: stretch; gap: 6px; }
.cc-row input[type=range] { width: 100%; accent-color: var(--accent); }
@keyframes pop { from { opacity: 0; transform: translateY(-3px); } }

/* ---------- Windows ---------- */
.win { position: absolute; display: flex; flex-direction: column; min-width: 240px; min-height: 140px; background: var(--paper); border: 1.5px solid var(--line); border-radius: 6px; overflow: hidden; pointer-events: auto; transition: box-shadow .15s; }
.win.active { box-shadow: 3px 3px 0 var(--shadow); }
.win.max { border-radius: 0; border-width: 0 0 1.5px; box-shadow: none; }
.win.is-min { display: none; }
.titlebar { height: 30px; display: flex; align-items: center; justify-content: space-between; padding: 0 4px 0 6px; background: var(--chrome); border-bottom: 1.5px solid var(--line); touch-action: none; flex: none; }
.win.active .titlebar { background: repeating-linear-gradient(0deg, var(--chrome) 0 2px, var(--chrome-d) 2px 3px); }
.ttl { display: flex; align-items: center; gap: 8px; padding: 0 8px 0 4px; background: var(--chrome); font-weight: 700; font-size: 13px; white-space: nowrap; }
.win:not(.active) .ttl { color: var(--ink-2); font-weight: 400; }
.ctrls { display: flex; gap: 4px; padding-left: 6px; background: var(--chrome); }
.wbtn { width: 20px; height: 20px; display: grid; place-items: center; padding: 0; border: 1.5px solid var(--line); border-radius: 4px; background: var(--chrome); font-size: 12px; }
.wbtn:hover { background: var(--ink); color: var(--paper); }
.wbtn.close:hover { background: var(--bad); border-color: var(--bad); color: #fff; }
.win-body { flex: 1; min-height: 0; position: relative; display: flex; flex-direction: column; background: var(--paper); }
.grip { position: absolute; right: 0; bottom: 0; width: 16px; height: 16px; cursor: nwse-resize; touch-action: none; background: linear-gradient(135deg, transparent 0 50%, var(--line) 50% 56%, transparent 56% 70%, var(--line) 70% 76%, transparent 76%); }

.toolbar { display: flex; align-items: center; gap: 6px; padding: 6px; background: var(--chrome); border-bottom: 1.5px solid var(--line); flex: none; }
.toolbar .status { margin-left: auto; font-size: 12px; color: var(--ink-2); padding-right: 4px; }
.tbtn { width: 28px; height: 28px; display: grid; place-items: center; padding: 0; border: 1.5px solid transparent; border-radius: 4px; background: transparent; font-size: 16px; flex: none; }
.tbtn:hover:not(:disabled) { border-color: var(--line); background: var(--paper); }
.tbtn:disabled { opacity: .35; cursor: default; }

/* Browser */
.viewport { position: relative; flex: 1; min-height: 0; }
.frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #fff; }
.browser-home { position: absolute; inset: 0; padding: 22px; overflow: auto; display: grid; gap: 14px; align-content: start; }
.browser-home .quick { display: grid; gap: 6px; max-width: 360px; }
.quick button { display: grid; text-align: left; padding: 8px 10px; border: 1.5px solid var(--line); border-radius: 5px; background: var(--paper); }
.quick button:hover { background: var(--chrome); }
.notice { padding: 5px 10px; font-size: 12px; color: var(--ink-2); background: var(--chrome); border-top: 1.5px solid var(--line); flex: none; }

/* App store */
.intro { padding: 12px 14px 0; color: var(--ink-2); }
.list { flex: 1; overflow: auto; padding: 12px; display: grid; gap: 8px; align-content: start; }
.row { display: flex; align-items: center; gap: 12px; padding: 10px; border: 1.5px solid var(--line); border-radius: 6px; }
.row .meta { flex: 1; min-width: 0; display: grid; }
.row .tag { font-size: 12px; color: var(--ink-2); padding: 0 6px; }

/* Arcade */
.stage { flex: 1; display: grid; place-items: center; padding: 12px; overflow: auto; }
.snake { display: grid; gap: 8px; justify-items: center; }
.hud { display: flex; justify-content: space-between; width: 100%; font-weight: 700; }
.snake canvas { max-width: 100%; height: auto; border: 1.5px solid var(--line); touch-action: none; }
.hint { font-size: 12px; color: var(--ink-2); }
.ttt-wrap { display: grid; gap: 12px; justify-items: center; }
.ttt-controls { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
.ttt { display: grid; grid-template-columns: repeat(3, 76px); gap: 6px; }
.cell { height: 76px; border: 1.5px solid var(--line); border-radius: 6px; background: var(--chrome); font-size: 36px; font-weight: 700; line-height: 1; }
.cell:hover:not(:disabled) { background: var(--chrome-d); }
.cell.o { color: var(--accent); }
.cell.win { background: var(--hi); color: #1e1f1e; }
.cell:disabled { cursor: default; }
.ttt-status { font-weight: 700; min-height: 1.4em; }

/* Notes */
.notes { flex: 1; width: 100%; resize: none; border: 0; outline: none; padding: 4px 16px; font: inherit; font-size: 15px; line-height: 24px; color: var(--ink); background-color: var(--paper); background-image: repeating-linear-gradient(transparent 0 23px, var(--rule) 23px 24px); background-attachment: local; background-position: 0 3px; }

/* Calculator */
.calc { padding: 10px; display: grid; grid-template-rows: auto 1fr; gap: 10px; height: 100%; }
.calc-screen { border: 1.5px solid var(--line); border-radius: 5px; padding: 8px 10px; text-align: right; min-height: 78px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
.calc-expr { font-size: 12px; color: var(--ink-2); min-height: 1.4em; }
.calc-res { font-weight: 700; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; line-height: 1.1; }
.keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
.key { border: 1.5px solid var(--line); border-radius: 5px; background: var(--paper); font-size: 18px; font-weight: 700; }
.key:hover { background: var(--chrome); }
.key:active { transform: translateY(1px); }
.key.op { background: var(--chrome-d); }
.key.eq { background: var(--accent); color: var(--on-accent); }
.key.clr { background: var(--hi); color: #1e1f1e; }
.key.wide { grid-column: span 2; }

/* Settings */
.pane { padding: 16px; display: grid; gap: 20px; overflow: auto; align-content: start; }
.pane h3 { margin: 0 0 8px; font-size: 14px; }
.swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(88px, 1fr)); gap: 10px; }
.swatch-btn { display: grid; gap: 6px; padding: 2px; border: 0; background: none; font-size: 12px; text-align: center; }
.swatch { display: block; height: 52px; border: 1.5px solid var(--line); border-radius: 5px; }
.swatch-btn[aria-pressed="true"] .swatch { outline: 3px solid var(--accent); outline-offset: 2px; }
.swatch-btn[aria-pressed="true"] { font-weight: 700; }
.tile { position: relative; display: grid; }
.swatch.add { display: grid; place-items: center; border-style: dashed; background: var(--paper); font-size: 20px; }
.swatch-x { position: absolute; top: -6px; right: -6px; width: 20px; height: 20px; display: grid; place-items: center; padding: 0; border: 1.5px solid var(--line); border-radius: 50%; background: var(--paper); font-size: 11px; }
.swatch-x:hover { background: var(--bad); border-color: var(--bad); color: #fff; }
.looks { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 10px; }
.look-btn { display: grid; gap: 6px; padding: 2px; border: 0; background: none; font-size: 12px; text-align: center; }
.look { display: flex; height: 40px; border: 1.5px solid var(--line); border-radius: 5px; overflow: hidden; }
.look i { flex: 1; }
.look-btn[aria-pressed="true"] .look { outline: 3px solid var(--accent); outline-offset: 2px; }
.look-btn[aria-pressed="true"] { font-weight: 700; }
.accents { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.dotbtn { width: 28px; height: 28px; padding: 0; border: 1.5px solid var(--line); border-radius: 50%; }
.dotbtn[aria-pressed="true"] { outline: 3px solid var(--accent); outline-offset: 2px; }
.btn[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
.pane .row-actions { display: flex; gap: 8px; }
.w-custom { background-color: #111; background-position: center; background-repeat: no-repeat; }
.fit-fill { background-size: cover; }
.fit-fit { background-size: contain; }
.fit-tile { background-size: auto; background-repeat: repeat; }
#lock::before, #setup::before { content: ""; position: absolute; inset: 0; background: rgba(0, 0, 0, .22); }

/* Terminal */
.term { flex: 1; min-height: 0; background: #101312; color: #d7e0da; font-family: var(--mono); font-size: 13px; padding: 10px; overflow: auto; user-select: text; -webkit-user-select: text; }
.term .out > div { white-space: pre-wrap; word-break: break-word; }
.term .prompt { color: #e8b94a; margin-right: 8px; }
.term .err { color: #ef8b7a; }
.term .dim { color: #8e9b95; }
.term .inline { display: flex; align-items: center; }
.term input { flex: 1; min-width: 0; background: transparent; border: 0; outline: none; color: inherit; font: inherit; user-select: text; }

/* ---------- Motion ---------- */
.win.tween { transition: box-shadow .15s, left .24s cubic-bezier(.2,.8,.2,1), top .24s cubic-bezier(.2,.8,.2,1), width .24s cubic-bezier(.2,.8,.2,1), height .24s cubic-bezier(.2,.8,.2,1); }
.ghost { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
.screen { animation: fadeIn .25s ease-out; }
.dialog { animation: dialogIn .24s cubic-bezier(.2,.8,.2,1); }
.appicon { transition: transform .1s; }
.dicon:active .appicon { transform: scale(.93); }
.task-btn:active { transform: translateY(1px); }
