    bar.append(h('button', { class: 'task-btn', type: 'button', 'data-key': key, onclick: () => taskClick(key) },
      appIcon(key, 24), h('span', { class: 'tl' }, APPS[key].name)));
  });
  updateTaskbar();
}
function taskClick(key) {
  const rec = wins.get(key);
  if (!rec) openApp(key);
  else if (rec.min) focusWin(key);
  else if (focusedKey === key) minimizeWin(key);
  else focusWin(key);
}
function updateTaskbar() {
  $$('.task-btn').forEach((b) => {
    const rec = wins.get(b.dataset.key);
    b.classList.toggle('open', !!rec);
    b.classList.toggle('min', !!rec && rec.min);
    b.classList.toggle('focused', focusedKey === b.dataset.key);
